# Copy this file to smtp.env and replace the values with your email provider settings.
# Keep smtp.env private. It can contain an email app password.

PHISHGUARD_SMTP_HOST=smtp.gmail.com
PHISHGUARD_SMTP_PORT=587
PHISHGUARD_SMTP_FROM=your-email@gmail.com
PHISHGUARD_SMTP_USERNAME=your-email@gmail.com
PHISHGUARD_SMTP_PASSWORD=your-gmail-app-password
PHISHGUARD_SMTP_TLS=1
